# Copy to .env and fill in. Never commit .env (it's gitignored).
# Adzuna free developer keys: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Greenhouse and Lever public board APIs need no key.
# Workday public job feeds need no key.

# ---- Optional daily email notifier (schedule/notify.js) ----
# Leave ENABLE_NOTIFY unset or 0 to disable. For Gmail, create an "App Password"
# (Google Account > Security > 2-Step Verification > App passwords) — do NOT use
# your normal login password.
ENABLE_NOTIFY=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_TO=
